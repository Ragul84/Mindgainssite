[["எட்டுத்தொகை நூல்களுள் முதலாவது வைத்து எண்ணப்படும் நூல்",["அகநானூறு","ஐங்குறுநூறு","நற்றிணை","பரிபாடல்"],2],["அகத்திணையும் புறத்திணையும் சேர்த்துக் கூறும் எட்டுத்தொகை நூல் எது?",["பரிபாடல்","நற்றிணை","ஐங்குறுநூறு","பதிற்றுப்பத்து"],0],["தவறான இணையைத் தேர்வு செய்க:",["குறிஞ்சி - கபிலர்","முல்லை - ஓதலாந்தையார்","மருதம் - ஓரம்போகியார்","நெய்தல் - அம்மூவனார்"],1],["பின்வருவனவற்றுள் தவறானதைத் தேர்வு செய்க:",["கம்பர் தேரழுந்தூரில் பிறந்தவர்","கம்பரை ஆதரித்த வள்ளல் சீதக்காதி","ஏர் எழுபது இயற்றியவர் கம்பர்","கம்பரது காலம் கி.பி. பன்னிரண்டாம் நூற்றாண்டு"],1],["'செல்வச் செவிலி' - இலக்கணக் குறிப்பு",["உவமை","அடுக்குத்தொடர்","எண்ணும்மை","உருவகம்"],3],["'குன்றேறி யானைப்போர் கண்டற்றால் தன்கைத்தொன்று உண்டாகச் செய்வான் வினை' - 'கைத்தொன்று' என்பதன் பொருள்",["படைக்கவசம்","படைக்கருவிகள்","கைப்பொருள்","வலிமையான ஆயுதம்"],2],["'பற்றுக பற்றற்றான் பற்றினை அப்பற்றைப் பற்றுக பற்று விடற்கு' - எதுகை வகை",["பொழிப்பு எதுகை","கூழை எதுகை","மேற்கதுவாய் எதுகை","கீழ்க்கதுவாய் எதுகை"],1],["'அழக்கொண்ட எல்லாம் அழப்போம், இழப்பினும்' - இந்த அடியில் அமைந்துள்ள எதுகை",["கூழை எதுகை","மேற்கதுவாய் எதுகை","கீழ்க்கதுவாய் எதுகை","பொழிப்பு எதுகை"],1],["தன்வினை வாக்கியத்தைத் தேர்ந்தெடுக்க:",["அப்பூதி அடிகள் நான்மறை கற்கவில்லை","அப்பூதி அடிகள் நான்மறை கற்றார்","அப்பூதி அடிகள் நான்மறை கற்றாரா?","அப்பூதி அடிகள் நான்மறை கற்பித்தார்"],1],["இலக்கணக் குறிப்புத் தருக: 'கங்கையும் சிந்துவும்'",["உம்மைத்தொகை","பெண்பால் பெயர்கள்","எண்ணும்மை","அன்மொழித்தொகை"],2],["சால, தவ முதலிய உரிச்சொற்களின் பின் வல்லினம்",["மிகும்","மிகாது","சில இடங்களில் வரும்","சில இடங்களில் வராது"],0],["'தாழ்பூந்துறை' - இலக்கணக் குறிப்பு",["ஏவல் வினைமுற்று","உரிச்சொல் தொடர்","பண்புத்தொகை","வினைத்தொகை"],3],["பின்வருவனவற்றுள் நிகழ்கால வினைமுற்றைத் தேர்வு செய்க.",["பழுத்த பழம்","பழுக்கும் பழம்","பழுக்கின்றது","பழங்கள் பழுத்தன"],2],["'படி' என்ற வேர்ச்சொல்லில் இருந்து வினையெச்சத்தை உருவாக்குக.",["படித்து","படித்தல்","படித்த","பாடுதல்"],0],["'கல்' என்னும் வேர்ச்சொல்லின் பதம் அறிக.",["கற்றல்","கற்பனை","கண்டான்","கல்லை"],0],["'இயல்பானது' - வேர்ச்சொல் அறிக.",["இயல்","இயல்பு","இயைபு","இய"],0],["'ஏ' என்ற ஓரெழுத்து ஒருமொழியின் பொருள்",["தலைவன்","நெருப்பு","அரண்","அம்பு"],3],["'குழலியும் பாடத் தெரியும்' - பிழை நீக்கிய சரியான தொடர்",["குழலிக்குப் பாடத்தெரியும்","குழலியின் பாடத்தெரியும்","குழலி பாடத்தெரியும்","குழலியால் பாடத்தெரியும்"],0],["தமிழ்ச் சொல்லைக் கண்டறிக:",["அனுமதி","ஈசன்","குபேரன்","மணிமுடி"],3],["பொருந்தா இணையைச் சுட்டுக:",["குறிஞ்சி - யாமம்","முல்லை - மாலை","மருதம் - நண்பகல்","நெய்தல் - எற்பாடு"],2],["'கலைச்செல்வி கட்டுரை எழுதினாள்' - இத்தொடருக்குரிய சரியான எதிர்மறைத் தொடர்",["கலைச்செல்வி கட்டுரை எழுதிலள்","கலைச்செல்வி கட்டுரை எழுத விரும்பவில்லை","கலைச்செல்வி கட்டுரை எழுதாமல் இராள்","கலைச்செல்வி கட்டுரை வாசிக்கவில்லை"],0],["தாயுமானவர் பற்றிய சரியான கூற்றுகள்: 1. பிறந்த ஊர் நாகப்பட்டினம் மாவட்டத்திலுள்ள திருமறைக்காடு 2. காலம் கி.பி. பதினெட்டாம் நூற்றாண்டு 3. 'தாயுமானவர் திருப்பாடல் திரட்டு' இவர் எழுதிய நூல் 4. திருச்சியை ஆண்ட விசயரகுநாத சொக்கலிங்கரிடம் கருவூல அலுவலராகப் பணியாற்றியவர்",["1, 4 சரி","2, 3 சரி","2, 4 சரி","1, 3 சரி"],1],["தாயுமானவர் ஆற்றிய பணி எது?",["அரசுக் கணக்கர்","தட்டச்சுப் பணியாளர்","பத்திரிகையாளர்","இசைப் பணியாளர்"],0],["தென்னாப்பிரிக்க வரலாற்றில் யாருடைய பெயர் நிலைத்து நிற்கும் என்று காந்தியடிகள் குறிப்பிட்டார்?",["திலகவதி","தில்லையாடி வள்ளியம்மை","ஜான்சிராணி","நாகம்மை"],1],["உலகம் உருண்டையானது என்பதைத் தம் தொலைநோக்கியால் கண்டறிந்து சொன்னவர் யார்?",["கலீலியோ","நிகோலஸ் கோப்பர்நிக்கஸ்","சி.வி. இராமன்","தாமஸ் ஆல்வா எடிசன்"],0],["தமிழுக்கு அரும்பணி ஆற்றிய அமெரிக்கப் பேராசிரியர்களில் ஒருவர்",["ஆறுமுக நாவலர்","ஜோசப் கொன்ஸ்டான்ஸ்","ஜேம்ஸ் பிராங்கா","ஜி.யு. போப்"],2],["'இங்கே ஒரு தமிழ் மாணவன் உறங்கிக் கொண்டிருக்கிறான்' என்று தன் கல்லறையில் எழுதச் சொன்னவர் யார்?",["கால்டுவெல்","ஜி.யு. போப்","வீரமாமுனிவர்","ஷெல்லி"],1],["'வீறுடைச் செம்மொழி தமிழ்மொழி உலகம் வேரூன்றிய நாள்முதல் உயிர்மொழி' என்று பறைசாற்றியவர் யார்?",["பாவலரேறு பெருஞ்சித்திரனார்","பெருங்குன்றூர் கிழார்","பரிதிமாற்கலைஞர்","பாவேந்தர் பாரதிதாசன்"],0],["'துரைமாணிக்கம்' என்பது இவரின் இயற்பெயர்",["கவிஞர் சுரதா","கவிஞர் மீரா","பாரதிதாசன்","பெருஞ்சித்திரனார்"],3],["திராவிட மொழிகளின் ஆய்விற்குப் பங்களிப்புச் செய்தவர்களில் குறிப்பிடத்தக்கவர்",["சி.வை. தாமோதரம்","வ.சுப. மாணிக்கம்","தெ.பொ. மீனாட்சி சுந்தரனார்","மயிலை சீனி. வேங்கடசாமி"],2],["பரிதிமாற்கலைஞர் நடத்தி வந்த 'ஞானபோதினி' இதழைத் தொடங்கி வைத்தவர்",["மு.சி. பூர்ணலிங்கம்","தெ.பொ. மீனாட்சி சுந்தரம்","கே.வி. சுப்பையா","எல்.வி. இராமசுவாமி"],0],["'கதையை வாசிப்பது நமது சிந்தனையின் சலனத்தை ஊக்குவதற்கு ஒரு தூண்டுகோல்' எனக் கூறியவர்",["கந்தர்வன்","நாஞ்சில் நாடன்","புதுமைப்பித்தன்","வண்ணதாசன்"],2],["தொல்காப்பியத்தில் நாடகப் பாங்கிலான உணர்வுகளுக்கு இலக்கணம் வகுத்த இயல்",["மரபியல்","பொருளியல்","மெய்ப்பாட்டியல்","களவியல்"],2],["பண்ணொடு கலந்தும் தாளத்தோடு கூடியும் பாடும் கலை",["நாடகக்கலை","நாட்டியக்கலை","இசைக்கலை","ஓவியக்கலை"],2],["தமிழக அரசின் தமிழ் வளர்ச்சித்துறை பரிசு பெற்ற சுரதாவின் நூல்",["துறைமுகம்","சுவரும் சுண்ணாம்பும்","தேன்மழை","சுரதாவின் கவிதைகள்"],2],["'இரட்டைக்கிளவி போல் இணைந்தே வாழுங்கள் பிரிந்தால் பொருளில்லை' என்று பாடியவர்",["சுரதா","மு. மேத்தா","தாரா பாரதி","அப்துல் ரகுமான்"],0],["பாரதிதாசனார் இயற்றிய நாடக நூல் எது?",["கண்ணகி புரட்சிக்காப்பியம்","பிசிராந்தையார்","சுவரும் சுண்ணாம்பும்","பாண்டியன் பரிசு"],1],["நாமக்கல் கவிஞருக்குப் 'பத்மபூஷண்' விருது வழங்கியது",["நடுவண் அரசு","மாநில அரசு","ஆங்கில அரசு","பிரெஞ்சு அரசு"],0],["சித்தர்களின் ஆதி சித்தராகக் கருதப்படுபவர்",["பாம்பாட்டிச் சித்தர்","திருமூலர்","போகர்","கோரக்கர்"],1],["லிட்டன் பிரபு எழுதிய 'இரகசிய வழி' என்ற நூலைத் தழுவி வெளிவந்த நூல்",["மனோன்மணீயம்","அகத்தியம்","முறுவல்","குணநூல்"],0],["மனோன்மணீயத்தை இயற்றியவர்",["சுந்தரம் பிள்ளை","சுந்தர முனிவர்","சுந்தரர்","சுந்தரமூர்த்தி"],0],["செங்கீரைப் பருவம் பிள்ளைத்தமிழில் எந்தப் பருவம்?",["இரண்டாம் பருவம்","ஐந்தாம் பருவம்","முதற் பருவம்","மூன்றாம் பருவம்"],0],["பெரியபுராணத்திற்குச் சேக்கிழார் இட்ட பெயர்",["சிவதொண்டர் புராணம்","சிவனடியார் புராணம்","திருத்தொண்டர் புராணம்","தொண்டர்சீர் புராணம்"],2],["சுந்தரம்பிள்ளையைப் போற்றும் முகமாகத் தமிழக அரசு நிறுவியது",["பல்கலைக்கழகம்","அரசவைக் கவிஞர் பணி","அறக்கட்டளை","பேராசிரியர் பணி"],0],["குண்டலகேசியின் வேறு பெயர்",["கைகேயி","பத்திரை","சுமத்திரை","மாதவி"],1],["கவுந்தியடிகள் எந்த மதத்தைச் சார்ந்த துறவி?",["சமணத் துறவி","பௌத்தத் துறவி","இஸ்லாமியத் துறவி","சைவத் துறவி"],0],["சிலப்பதிகாரத்தின் தொடர்ச்சியாகக் கருதப்படும் நூல்",["சீவகசிந்தாமணி","மணிமேகலை","குண்டலகேசி","நீலகேசி"],1],["'அறம் எனப்படுவது யாதெனக் கேட்பின் மறவாது இது கேள்... உண்டியும் உடையும் உறையுளும்' - இவ்வடிகள் இடம்பெறும் நூல்",["சிலம்பு","கம்ப இராமாயணம்","மணிமேகலை","பெரிய புராணம்"],2],["குறுந்தொகை நூலின் பா வகை",["கலிப்பா","வஞ்சிப்பா","வெண்பா","அகவற்பா"],3],["'துடியன், நாயினன், தோல் செருப்பு ஆர்த்த பேர் அடியன்...' - இக்கூற்றுக்குரியவர்",["இராமன்","இலக்குவன்","அனுமன்","குகன்"],3],["பதினெண்கீழ்க்கணக்கு நூல்களுள் ஒன்று",["நற்றிணை","குறிஞ்சிப்பாட்டு","பரிபாடல்","ஏலாதி"],3],["பெருமுத்தரையர்கள் பற்றிய குறிப்புகள் அமைந்துள்ள நூல்",["இன்னா நாற்பது","நான்மணிக்கடிகை","நாலடியார்","சிறுபஞ்சமூலம்"],2],["பொருட்பாலின் இயல்கள்",["பாயிரம், இல்லறவியல், துறவறவியல், ஊழியல்","அரசியல், அங்கவியல், ஒழிபியல்","களவியல், கற்பியல்","பாயிரவியல், அரசியல், களவியல்"],1],["'வேய்புரை தோள்' என்ற உவமைத் தொடரின் பொருள்",["தென்னை போன்ற தோள்","பளிங்கு போன்ற தோள்","மூங்கில் போன்ற தோள்","வாழை போன்ற தோள்"],2],["பிறவினைச் சொற்றொடரைக் கண்டறிக.",["எழிலரசி சிலப்பதிகாரம் கற்றாள்","எழிலரசியால் சிலப்பதிகாரம் கற்பிக்கப்பட்டது","எழிலரசி சிலப்பதிகாரம் கல்லாள்","எழிலரசி சிலப்பதிகாரம் கற்பித்தாள்"],3],["'தாய்மொழியை உயிராகப் போற்றுமாறு ஆசிரியர் மாணவர்களிடம் கூறினார்' - எவ்வகை வாக்கியம்?",["அயற்கூற்று வாக்கியம்","நேர்க்கூற்று வாக்கியம்","கலவை வாக்கியம்","எதிர்மறை வாக்கியம்"],0],["'பாத்திமா திருக்குறள் கற்பித்தாள்' - எவ்வகை வாக்கியம்?",["தன்வினை வாக்கியம்","செய்வினை வாக்கியம்","பிறவினை வாக்கியம்","செயப்பாட்டுவினை வாக்கியம்"],2],["'அவன் சித்திரையான்' - எவ்வகைப் பெயர்?",["குணப் பெயர்","இடப் பெயர்","காலப் பெயர்","சினைப் பெயர்"],2],["சொற்களை ஒழுங்குபடுத்திச் சொற்றொடராக்குக.",["மாலைமீது மலையின் மழை பெய்தது நேற்று","மலையின் மாலை மீது நேற்று பெய்தது மழை","நேற்று மாலை மலையின் மீது மழை பெய்தது","பெய்தது மழை மலையின் மீது நேற்றுமாலை"],2],["அகரவரிசைப்படி சொற்களைச் சீர்செய்து எழுதுக.",["கொன்றை, கெண்டை, கண், கீரன், காடை","கெண்டை, கீரன், கொன்றை, காடை, கண்","கண், காடை, கீரன், கெண்டை, கொன்றை","கண், கீரன், காடை, கொன்றை, கெண்டை"],2],["'ஜெராக்ஸ்' (Xerox) என்ற ஆங்கிலச் சொல்லுக்கு நேரான தமிழ்ச்சொல்",["ஒளிநகல்","ஒலி நகல்","அசல் படம்","மறுபடம்"],0],["'பாகற்காய்' - பிரித்தெழுதுக.",["பாகு + அல் + காய்","பாகு + அற்காய்","பாகற் + காய்","பாகு + கல் + காய்"],0],["'பைந்நிணம்' - பிரித்தெழுதுக.",["பை + நிணம்","பை + இனம்","பசுமை + நிணம்","பசுமை + இனம்"],2],["'திருத்தொண்டர் புராணம்' என்ற அடைமொழியால் அழைக்கப்படும் நூல்",["திருவிளையாடற்புராணம்","மேருமந்தர புராணம்","திருவாசகம்","பெரியபுராணம்"],3],["மூன்றடிச் சிற்றெல்லையும் ஆறடிப் பேரெல்லையும் கொண்ட அகவற்பாக்களால் ஆன நூல்",["ஐங்குறுநூறு","குறுந்தொகை","கலித்தொகை","புறநானூறு"],0],["தவறான இணை எது?",["மணித்தக்காளி - வாய்ப்புண்","முசுமுசுக்கை வேர் - இருமல்","அகத்திக் கீரை - கண்நோய்","வேப்பங்கொழுந்து - மார்புச்சளி"],2],["அகர வரிசைப்படுத்துக.",["மிளகு, மருங்கை, முசிறி, மூதூர், மேற்குமலை","முசிறி, மூதூர், மிளகு, மேற்குமலை, மருங்கை","மருங்கை, மிளகு, முசிறி, மூதூர், மேற்குமலை","மருங்கை, முசிறி, மூதூர், மிளகு, மேற்குமலை"],2],["தென்னாட்டைத் தன்னந்தனியே ஆண்ட பெண்ணரசி என்னும் புகழைப் பெற்றவர்",["இராணி மங்கம்மாள்","ஜான்சி ராணி","தில்லையாடி வள்ளியம்மை","வேலுநாச்சியார்"],0],["காடுகளில் வாழ்ந்த மக்கள் விலங்கின் பெயர் கொண்டு அமைத்த ஊரின் பெயர்",["ஆட்டையாம்பட்டி","வேப்பனேரி","புளியம்பட்டி","புளியங்குடி"],0],["இந்திய அரசியலமைப்புச் சட்டத்தை உருவாக்கிய சிற்பி",["அம்பேத்கர்","இராஜாஜி","அண்ணா","காமராசர்"],0],["தமிழில் 'சதுரகராதி' என்னும் அகரமுதலியை வெளியிட்டவர்",["ஜி.யு. போப்","வீரமாமுனிவர்","எச்.ஏ. கிருஷ்ணப்பிள்ளை","ரா.பி. சேதுப்பிள்ளை"],1],["'தபோலி' என்னும் சிற்றூர் எந்த மாநிலத்தில் உள்ளது?",["மராட்டிய மாநிலம்","குஜராத் மாநிலம்","தமிழ்நாடு","கர்நாடகம்"],0],["பரிதிமாற்கலைஞர் என்று போற்றப்படுபவர்",["மறைமலையடிகள்","உ.வே. சாமிநாத ஐயர்","வி.கோ. சூரியநாராயண சாஸ்திரியார்","வையாபுரிப்பிள்ளை"],2],["'தமிழே மிகவும் பண்பட்ட மொழி' என்று பாராட்டியவர் யார்?",["கமில் சுவலபில்","மாக்ஸ் முல்லர்","முனைவர் எமினோ","வில்லியம் ஜோன்ஸ்"],1],["விளையாட்டின் அடிப்படை நோக்கம் என்ன?",["போட்டி","பொழுதுபோக்கு","உடற்பயிற்சி","உற்சாகம்"],0],["ஒருவர் மட்டும் பார்க்கும் படக்கருவியைக் கண்டுபிடித்தவர் யார்?",["எட்வர்டு மைபிரிட்ஜ்","வால்ட் விட்மன்","எடிசன்","கீட்ஸ்"],2],["'எழுத்து' இதழைத் தொடங்கி நவீன தமிழ் இலக்கிய மறுமலர்ச்சிக்கு வித்திட்டவர்",["சிற்பி","சி.சு. செல்லப்பா","ந. பிச்சமூர்த்தி","மு. மேத்தா"],1],["வழக்குரைஞராகவும் இந்துசமய அறநிலையப் பாதுகாப்புத் துறை அலுவலராகவும் பணியாற்றிய கவிஞர்",["அப்துல் ரகுமான்","சிற்பி","ந. பிச்சமூர்த்தி","இரா. மீனாட்சி"],2],["'ஒரு பூவின் மலர்ச்சியையும் ஒரு குழந்தையின் புன்னகையையும் புரிந்துகொள்ள அகராதிகள் தேவைப்படுவதில்லை. பாடலும் அப்படித்தான்!' என்று கூறியவர்",["மு. மேத்தா","பசுவய்யா","ந. பிச்சமூர்த்தி","ஈரோடு தமிழன்பன்"],3],["'தமிழகத்தின் வேர்ட்ஸ்வர்த்' என்று பாராட்டப்படும் கவிஞர்",["பாரதிதாசன்","நாமக்கல் கவிஞர்","வாணிதாசன்","முடியரசன்"],2],["'வாழ்வினிற் செம்மையைச் செய்பவள் நீயே' என்ற பாடலைத் தமிழ் வாழ்த்தாக ஏற்றுக்கொண்டுள்ள அரசு",["தமிழ்நாடு அரசு","புதுவை அரசு","பிரெஞ்சு அரசு","ஆங்கில அரசு"],1],["இளங்கோவடிகள் 'தண்டமிழ் ஆசான், சாத்தன் நன்னூற்புலவன்' என்று யாரைப் பாராட்டியுள்ளார்?",["நாதகுத்தனார்","தோலாமொழித்தேவர்","திருத்தக்க தேவர்","சீத்தலைச் சாத்தனார்"],3],["வாகீசர், அப்பர், தருமசேனர், தாண்டகவேந்தர் என்றெல்லாம் அழைக்கப்படுபவர்",["திருநாவுக்கரசர்","சுந்தரர்","திருஞானசம்பந்தர்","மாணிக்கவாசகர்"],0],["'ஏர்முனைக்கு நேரிங்கே எதுவுமே இல்லே' என்ற பாடலின் ஆசிரியர்",["பட்டினத்தார்","மருதகாசி","உடுமலை நாராயணகவி","பட்டுக்கோட்டை கல்யாணசுந்தரம்"],1],["'காவடிச் சிந்தின் தந்தை' என அழைக்கப்படுபவர்",["பாரதியார்","சென்னிகுளம் அண்ணாமலையார்","அருணகிரியார்","விளம்பி நாகனார்"],1],["'நாயின் வாயினீர் தன்னை நீரெனா நவ்வி நாவினால் நக்கி விக்குமே' - இவ்வரிகள் இடம்பெற்ற நூல்",["வங்கத்துப் பரணி","திராவிடத்துப் பரணி","கலிங்கத்துப் பரணி","தக்கயாகப் பரணி"],2],["அதியமானின் தூதராக ஔவை சென்றதைக் கூறும் நூல்",["பதிற்றுப்பத்து","பரிபாடல்","புறநானூறு","ஆத்திசூடி"],2]]