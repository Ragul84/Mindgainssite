{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindgainssite",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only the quiz API and the (now private) bank go through the Worker; every other page
    // is still served straight from the asset store.
    "run_worker_first": ["/api/*", "/assets/quiz-data/*"]
  },
  "ratelimits": [
    { "name": "QUIZ_ROUND_RL", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } },
    { "name": "QUIZ_CHECK_RL", "namespace_id": "1002", "simple": { "limit": 90, "period": 60 } }
  ]
}
