{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindgainssite",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only the quiz API and the (now private) bank go through the Worker; every other page
    // is still served straight from the asset store.
    "run_worker_first": ["/api/*", "/assets/quiz-data/*"]
  },
  "ratelimits": [
    { "name": "QUIZ_ROUND_RL", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } },
    { "name": "QUIZ_CHECK_RL", "namespace_id": "1002", "simple": { "limit": 90, "period": 60 } },
    { "name": "GAME_ROUND_RL", "namespace_id": "1003", "simple": { "limit": 6, "period": 60 } },
    { "name": "GAME_SUBMIT_RL", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "GAME_DB", "database_name": "mindgains-game", "database_id": "434ed192-05f8-4308-bd2b-727fb85a69de" }
  ],
  "durable_objects": { "bindings": [ { "name": "THEATRE", "class_name": "TheatreHall" } ] },
  "migrations": [ { "tag": "theatre-v1", "new_sqlite_classes": ["TheatreHall"] } ],
  "vars": { "ALLOW_GUEST_LEAGUE": "1" }
}
